{
  "name": "looot-crm",
  "version": "0.1.0",
  "description": "A small CRM with buying-intent signals built in. Companies, contacts, a pipeline board and an Intent tab per account. Next.js, Supabase and looot.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "NEXT_PUBLIC_DEMO=1 next dev -p 3217",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "leak-scan": "LEAK_SCAN_ALLOWED_EMAILS='[.]example$' bash scripts/leak-scan.sh .",
    "test:rls": "bash scripts/test-rls.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
