# Demo mode: set to 1 to run on seeded data with no Supabase project and no looot token.
NEXT_PUBLIC_DEMO=

# Supabase project settings (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# looot agent token. Server only, never sent to the browser.
# Create one at https://looot.ai/settings with catalog.read, runs.read and runs.execute.
LOOOT_TOKEN=your-looot-agent-token
# Optional, defaults to https://api.looot.ai
LOOOT_API_URL=https://api.looot.ai

# Who may use the workspace (required outside demo). Comma separated, case-insensitive, exact match.
# With both empty the app shows a setup page and refuses data, settings and spending.
LOOOT_CRM_ALLOWED_EMAILS=you@example.com
LOOOT_CRM_ALLOWED_DOMAINS=

# Spending limits (optional, defaults shown)
PER_ACTION_MAX_USD=2
BULK_MAX_RECORDS=50
# Calls per user per minute to the quote and action routes
SPEND_RATE_LIMIT_PER_MIN=30

# Hosts an app connecting through MCP may send you back to after sign-in (optional, defaults shown)
MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
